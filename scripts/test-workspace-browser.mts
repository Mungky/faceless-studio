import assert from "node:assert/strict";
import {spawn,type ChildProcess} from "node:child_process";
import {mkdir,writeFile,readFile,access} from "node:fs/promises";
import path from "node:path";
import {randomBytes} from "node:crypto";
import {setTimeout as delay} from "node:timers/promises";
import puppeteer from "puppeteer-core";

const root=path.resolve(import.meta.dirname,".."),directory=path.join(root,".runtime","workspace-browser-"+Date.now());await mkdir(directory,{recursive:true});
const vault=path.join(directory,"vault");for(const name of ["Arthur","Not Yet","Exhibit Pop"]){await mkdir(path.join(vault,name),{recursive:true});await writeFile(path.join(vault,name,name+".md"),"Browser test fixture for "+name+". Preserve manual text and stop for approval.");}
const password=randomBytes(24).toString("hex"),port=21000+Math.floor(Math.random()*5000),base="http://127.0.0.1:3100",pb="http://127.0.0.1:"+port;
const env={...process.env,STUDIO_AUTOMATION_DISABLED:"1",POCKETBASE_URL:pb,PB_ADMIN_EMAIL:"ui-admin@studio.local",PB_ADMIN_PASSWORD:password,STUDIO_OWNER_EMAIL:"ui-owner@studio.local",STUDIO_OWNER_PASSWORD:password,VAULT_ROOT:vault,APP_URL:base,NINEROUTER_URL:"",RCLONE_REMOTE:"",ELEVENLABS_API_KEY:"",GOOGLE_CLIENT_ID:"",GOOGLE_CLIENT_SECRET:"",SEARXNG_URL:"",OBSCURA_MCP_URL:""};
const children:ChildProcess[]=[];let logs="";
function start(command:string,args:string[]){const child=spawn(command,args,{cwd:root,env,windowsHide:true,stdio:["ignore","pipe","pipe"]});child.stdout?.on("data",d=>{logs+=d;});child.stderr?.on("data",d=>{logs+=d;});children.push(child);return child;}
async function ready(url:string){for(let i=0;i<100;i++){try{if((await fetch(url,{signal:AbortSignal.timeout(1000)})).ok)return;}catch{}await delay(250);}throw new Error("Test server did not start. "+logs.slice(-1500));}
let browser:Awaited<ReturnType<typeof puppeteer.launch>>|undefined;
try{
  start(path.join(root,".runtime/pocketbase.exe"),["serve","--http=127.0.0.1:"+port,"--dir="+path.join(directory,"db"),"--migrationsDir="+path.join(root,"infra/pocketbase/pb_migrations"),"--hooksDir="+path.join(root,"infra/pocketbase/pb_hooks"),"--automigrate=false"]);await ready(pb+"/api/health");
  start(process.execPath,[path.join(root,"node_modules/next/dist/bin/next"),"dev",path.join(root,"apps/web"),"--hostname","127.0.0.1","--port","3100"]);await ready(base);
  const chrome="C:/Program Files/Google/Chrome/Application/chrome.exe";await access(chrome);browser=await puppeteer.launch({executablePath:chrome,headless:true,userDataDir:path.join(directory,"browser-profile"),args:["--no-first-run","--disable-default-apps"],defaultViewport:{width:1440,height:1000}});
  const page=await browser.newPage(),errors:string[]=[];page.on("pageerror",e=>errors.push(String(e)));await page.goto(base,{waitUntil:"networkidle0"});await page.type('input[name="email"]',env.STUDIO_OWNER_EMAIL);await page.type('input[name="password"]',password);await page.click('button[type="submit"]');await page.waitForSelector(".project-cards .project-card");assert.equal(await page.$$eval('.workspace-topbar>nav>button',buttons=>buttons.map(b=>b.textContent).join(",")),"Channel,Studio,FYP");await page.screenshot({path:path.join(directory,"channel-desktop.png")});{const open=await page.$$(".heading-actions button");await open[0].click();await page.waitForSelector(".connection-settings .settings-section");await new Promise(r=>setTimeout(r,1500));await page.screenshot({path:path.join(directory,"connections-desktop.png")});await page.evaluate(()=>{const m=document.querySelector(".modal,[role=dialog]");m?.scrollTo?.(0,99999);});await new Promise(r=>setTimeout(r,300));await page.screenshot({path:path.join(directory,"connections-desktop-2.png")});await page.keyboard.press("Escape");await new Promise(r=>setTimeout(r,300));if(await page.$(".connection-settings"))await page.click(".modal-close,[aria-label=Close],[aria-label=Tutup]").catch(()=>{});}
  await page.click('.workspace-topbar>nav>button:nth-child(2)');await page.waitForSelector(".template-grid");await page.screenshot({path:path.join(directory,"studio-desktop.png")});assert.equal(await page.$$(".template-card").then(a=>a.length),2);await page.click('.composer-modes button:nth-child(3)');await page.type('[aria-label="Judul episode"]',"Browser fixture manual episode");const manual="PRESENTER\nIni naskah manual.  Spasi tetap sama.\n\nPunchline saya.";await page.type('[aria-label="Naskah lengkap"]',manual);await page.click('.workspace-topbar>nav>button:nth-child(1)');await page.waitForSelector("dialog",{timeout:2500});await page.click('dialog .modal-actions .button:first-child');assert.equal(await page.$eval('[aria-label="Naskah lengkap"]',e=>(e as HTMLTextAreaElement).value),manual);await page.click('.episode-composer button[type="submit"]');await page.waitForSelector(".episode-document");assert.equal(await page.$eval('.episode-document',e=>(e as HTMLTextAreaElement).value),manual);await page.screenshot({path:path.join(directory,"episode-desktop.png")});
  await page.click('.stage-actions .button.primary');await page.waitForFunction(()=>document.querySelector('.stage-actions .button.primary')?.textContent!=="Setujui versi ini");await page.click('.episode-stages button:nth-child(4)');await page.waitForSelector(".composition-panel");await page.click('.stage-actions .button.primary');await page.waitForFunction(()=>document.querySelector('.stage-actions')?.textContent?.includes("Connect 9Router")||document.querySelector('.episode-output')?.textContent?.includes("Connect 9Router"));
  await page.click('.workspace-topbar>nav>button:nth-child(2)');await page.waitForSelector(".template-card-actions");await page.click('.template-card-actions .button:first-child');await page.waitForSelector('[aria-label="Isi template"]:not(:disabled)');assert.match(await page.$eval('[aria-label="Isi template"]',e=>(e as HTMLTextAreaElement).value),/Browser test fixture/);await page.focus('[aria-label="Isi template"]');await page.keyboard.down("Control");await page.keyboard.press("End");await page.keyboard.up("Control");await page.keyboard.type("\nAdditional template rule.");await page.keyboard.press("Escape");await page.waitForSelector(".template-discard-confirm");await page.click(".template-discard-confirm .button:first-child");await page.click('dialog button[type="submit"]');await page.waitForSelector("dialog",{hidden:true});
  await page.click('.workspace-topbar>nav>button:nth-child(1)');await page.waitForSelector(".project-card");await page.click('.project-cards>.project-card:first-child');await page.waitForSelector(".channel-tabs");await page.click('.channel-tabs button:nth-child(4)');await page.waitForSelector(".slot-chips");await page.select('.channel-settings form select',"arthur");await page.click('.slot-chips>.button');assert.equal(await page.$$(".slot-chips input").then(a=>a.length),2);await page.click('.channel-settings form button[type="submit"]');await page.waitForFunction(()=>document.querySelector('.form-actions [role="status"]')?.textContent?.includes("Tersimpan"));
  await page.click('.channel-tabs button:nth-child(2)');await page.waitForSelector(".production-rows>button");await page.click('.production-rows>button:first-child');await page.waitForSelector(".episode-document");await page.click('.episode-stages button:nth-child(3)');assert.equal(await page.$eval('.episode-document',e=>(e as HTMLTextAreaElement).value),manual);
  await page.focus('.episode-document');await page.keyboard.down("Control");await page.keyboard.press("End");await page.keyboard.up("Control");await page.keyboard.type(" Unsaved test change.");await page.click('.workspace-topbar>nav>button:nth-child(2)');await page.waitForSelector('dialog');assert.match(await page.$eval('dialog',e=>e.textContent||""),/Perubahan belum disimpan/);await page.click('dialog .modal-actions .button:last-child');await page.waitForSelector(".template-grid");await page.setViewport({width:390,height:844});await page.screenshot({path:path.join(directory,"studio-mobile.png"),fullPage:true});assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=window.innerWidth),true,"Studio must fit a phone viewport");
  await page.click('.workspace-topbar>nav>button:nth-child(3)');await page.waitForSelector(".fyp-page");assert.match(await page.$eval('.fyp-page',e=>e.textContent||""),/SearXNG belum terhubung/);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=window.innerWidth),true,"FYP must fit a phone viewport");await page.screenshot({path:path.join(directory,"fyp-mobile.png"),fullPage:true});assert.deepEqual(errors,[]);console.log("Browser checks passed: login, real database, three destinations, exact manual script, approval, honest provider failure, editable templates, channel defaults, multiple slots, recovery, unsaved guard and mobile layout.");
}catch(error){await writeFile(path.join(directory,"server.log"),logs);throw error;}
finally{await browser?.close();for(const child of children.reverse())child.kill();await Promise.all(children.map(child=>Promise.race([new Promise(resolve=>child.once("exit",resolve)),delay(3000)])));console.log("Browser test artifacts: "+directory);}
