  "narrative": {
    "northStar": "The quiet working dashboard",
    "overview": "The shipped Operate world follows the owner's explicit Linear reference: graphite grounds, restrained violet selection, compact navigation, and familiar web controls. Information and next actions carry the hierarchy. English copy and honest connection states make this a working private studio.\n\nThe build uses flat digital surfaces and consistent outline icons. It has no shipping raster artwork and no approved visual comp; source and rendered captures establish the system.",
    "keyCharacteristics": [
      "Compact sidebar and focused detail panels.",
      "Dense tables with tabular measurements.",
      "Quiet surface changes and thin separators.",
      "Violet selection and explicit status text.",
      "Responsive stacking with deliberate horizontal table scrolling."
    ],
    "rules": [
      {
        "name": "The Violet State Rule",
        "body": "Use violet for selection, primary actions, focus, and the retention trace; preserve semantic colors for operational status.",
        "section": "colors"
      },
      {
        "name": "The Measured Numbers Rule",
        "body": "Use tabular numerals for metrics and spending totals, and monospace for timestamps and code.",
        "section": "typography"
      },
      {
        "name": "The Preserve Readability Rule",
        "body": "Stack detail regions and scroll wide tables at small widths, retaining the hierarchy and readable controls.",
        "section": "layout"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use tonal layering and borders for resting work areas; reserve the shipped diffuse shadow for dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the compact sidebar, clear text hierarchy, and thin separators.",
      "Do pair every operational status color with a readable state label.",
      "Do keep measurements tabular and timestamps monospace.",
      "Do preserve accent focus outlines and reduced-motion behavior.",
      "Do show unavailable measurements as em dashes with an actionable explanation."
    ],
    "donts": [
      "Don't replace the confirmed quiet dashboard world with decorative display typography or raster decoration.",
      "Don't use shadows to separate ordinary workspace panels.",
      "Don't present fabricated performance values as live metrics."
    ]
  }
}
