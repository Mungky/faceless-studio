# Copy to .env; keep this file out of the vault. npm run setup:local generates local secrets.
TZ=Asia/Jakarta
APP_URL=http://127.0.0.1:3100
POCKETBASE_URL=http://127.0.0.1:8095
PB_ADMIN_EMAIL=admin@studio.local
PB_ADMIN_PASSWORD=
STUDIO_OWNER_EMAIL=owner@studio.local
STUDIO_OWNER_PASSWORD=
WORKER_TOKEN=
AUTOMATION_TOKEN=
OAUTH_ENCRYPTION_KEY=
VAULT_ROOT=D:/Faceless Creation/projects
STUDIO_CACHE_ROOT=D:/Faceless Creation/studio/.cache
WORKER_CACHE_ROOT=D:/StudioCache
WORKER_ID=laptop-worker
WORKER_GPU=
WORKER_SERVER_URL=http://127.0.0.1:3100
WORKER_CAPABILITIES=render,music,ffmpeg,image,video
RCLONE_BIN=rclone
RCLONE_CONFIG=
RCLONE_REMOTE=
NINEROUTER_URL=
NINEROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the registered OAuth redirect exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/api/oauth/callback
ACESTEP_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
# Status-only access to an existing Flow bridge. Automatic submission is disabled.
FLOW_BRIDGE_PORT=8791
FLOW_DOWNLOAD_ROOT=
FLOW_IMAGE_MODEL=nano-banana-pro
FLOW_VIDEO_MODEL=veo-3.1-fast
# Optional replacement generation provider. Endpoint must implement docs/CONNECTORS.md.
GENERATOR_WEBHOOK_URL=
GENERATOR_WEBHOOK_TOKEN=
FFMPEG_BIN=ffmpeg
PLAYWRIGHT_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe
# Compose only: a real Tailscale IP is required for network access. Never set 0.0.0.0.
TAILSCALE_IP=127.0.0.1
N8N_VERSION=2.45.4
NINEROUTER_VERSION=0.5.111
N8N_ENCRYPTION_KEY=
SERVER_VAULT_ROOT=../../projects
# Host-side operational commands. Keep backup storage outside the vault/Git.
BACKUP_LOCAL_DIR=.backups
BACKUP_RCLONE_REMOTE=
BACKUP_TIMEOUT_SECONDS=600
# Existing vault repository root; defaults to VAULT_ROOT when blank.
VAULT_GIT_ROOT=
# Published + 30 days raw clips archive, same remote as RCLONE_REMOTE.
# Must equal RCLONE_REMOTE + Faceless/.archive; blank disables archiving.
RETENTION_ARCHIVE_REMOTE=
RETENTION_MANIFEST_DIR=.retention
RETENTION_TIMEOUT_SECONDS=120
